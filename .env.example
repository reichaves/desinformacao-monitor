# ============================================================
# Disinformation Monitor — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# --- Google Drive (optional) ---
# Set ENABLE_GOOGLE_DRIVE=true to upload results to Drive after each run.
ENABLE_GOOGLE_DRIVE=false

# Service account JSON encoded as base64:
#   Linux/Mac: base64 -i service-account.json
#   Windows:   certutil -encode service-account.json encoded.txt (then remove header/footer)
GOOGLE_DRIVE_CREDENTIALS_B64=your_base64_encoded_service_account_json

# ID of the Drive folder where results will be stored.
# Found in the URL: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# --- Pipeline tuning ---
MAX_VIDEOS_PER_RUN=20
SCREENSHOT_INTERVAL_SECONDS=3
HOURS_BACK=24

# --- Paths ---
DATA_DIR=data
DOCS_DIR=docs
KEYWORDS_PATH=config/keywords.json
